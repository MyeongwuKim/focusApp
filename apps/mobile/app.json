{
  "expo": {
    "name": "데일로",
    "slug": "dailo",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "requireFullScreen": true,
      "bundleIdentifier": "com.myeongwu.focushybrid",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleLocalizations": ["ko"],
        "NSLocationWhenInUseUsageDescription": "집중 기록 화면에서 위치 기반 기능(예: 날씨)을 제공하기 위해 위치 권한이 필요합니다.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "locales": {
      "ko": "./locales/ko.json"
    },
    "android": {
      "permissions": ["POST_NOTIFICATIONS", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "backgroundColor": "#F8EDCA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.myeongwu.focushybrid"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent",
          "ios": {
            "launchMode": "most-recent"
          },
          "android": {
            "launchMode": "most-recent"
          }
        }
      ],
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-full-base.png",
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true,
          "backgroundColor": "#F8EDCA",
          "dark": {
            "backgroundColor": "#F8EDCA"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db2742d9-396e-44bf-812a-be29dbc594d3"
      }
    },
    "owner": "myeongwukim"
  }
}
